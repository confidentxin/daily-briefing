# 复制这个文件为 .env，再把密钥填进去。密钥不要提交到 Git。
# 本地试跑（dry-run）只需要前两个密钥；发邮件才需要后三个。

# Groq 密钥：https://console.groq.com/keys 申请，免费，密钥以 gsk_ 开头。
GROQ_API_KEY=your_groq_key_here
# 可选项——覆盖 config.yaml 里的 `model:`，模型下线时救急用。
# GROQ_MODEL=openai/gpt-oss-120b
# Tavily 密钥：https://app.tavily.com 申请，免费（每月 1000 积分），密钥以 tvly- 开头。
TAVILY_API_KEY=your_tavily_key_here
# 下面三个只在真正发邮件时需要，试跑不需要填。
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
RECIPIENT_EMAIL=where_you_want_it_delivered@example.com
